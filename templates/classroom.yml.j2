name: Autograding Tests
'on':
  - push
  - repository_dispatch
permissions:
  checks: write
  actions: read
  contents: read
jobs:
  run-autograding-tests:
    runs-on: ubuntu-latest
    if: github.actor != 'github-classroom[bot]'
    steps:
    - name: Checkout code
      uses: actions/checkout@v4

{% if stack == "django-react" %}
    - name: Setup Python
      uses: actions/setup-python@v5
      with:
        python-version: "3.12"

    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: "20"

    - name: Install backend dependencies
      run: pip install pytest pytest-django django djangorestframework

    - name: Install frontend dependencies
      run: |
        cd src/kadai/frontend
        npm ci
{% elif stack == "javascript" %}
    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: "20"
        cache: "npm"
        cache-dependency-path: "src/kadai/package-lock.json"

    - name: Install dependencies
      run: |
        cd src/kadai
        npm ci
{% else %}
    - name: Setup environment
      run: |
        pip install pytest
{% endif %}
{% for stage in stages %}
    - name: {{ stage.name }}
      id: {{ stage.name }}
      uses: classroom-resources/autograding-command-grader@v1
      with:
        test-name: {{ stage.name }}
{% if stack == "django-react" %}
        command: "pytest -m '{{ stage.name }}' && npx --prefix src/kadai/frontend jest tests/stages/{{ stage.name }}/ --passWithNoTests"
        timeout: 30
{% elif stack == "javascript" %}
        command: "cd src/kadai && npx jest --ci ../../tests/stages/{{ stage.name }}/ --passWithNoTests"
        timeout: 10
{% else %}
        command: "pytest -m '{{ stage.name }}'"
        timeout: 10
{% endif %}
        max-score: {{ stage.score }}
{% endfor %}
    - name: Autograding Reporter
      uses: classroom-resources/autograding-grading-reporter@v1
      env:
{%- for stage in stages %}
        {{ stage.name | upper }}_RESULTS: "${{ '{{' }}steps.{{ stage.name }}.outputs.result{{ '}}' }}"
{%- endfor %}
      with:
        runners: {{ stages | map(attribute='name') | join(',') }}
